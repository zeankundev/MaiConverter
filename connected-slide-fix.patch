+def test_three_segment_chain_and_trailing_rest():
+    ma2 = MaiMa2()
+    ma2.set_bpm(0.0, 120)
+    ma2.add_tap(1.0, 0, is_star=True)
+    ma2.add_slide(1.0, 0, 2, 0.5, 1)
