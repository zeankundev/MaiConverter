+def test_connected_slide_is_a_single_slide_with_star():
+    ma2 = MaiMa2()
+    ma2.set_bpm(0.0, 120)
+    ma2.add_tap(1.0, 0, is_star=True)
+    ma2.add_slide(1.0, 0, 2, 1.0, 1)
